{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "admin"],
      "port": 3200
    },
    {
      "name": "admin-alt",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d admin && npx next dev -p 3210"],
      "port": 3210
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3300", "--directory", "site"],
      "port": 3300
    }
  ]
}
