{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(dart format:*)",
      "PowerShell(flutter analyze:*)",
      "PowerShell(flutter test:*)",
      "PowerShell(flutter gen-l10n:*)",
      "PowerShell(flutter pub get:*)",
      "PowerShell(flutter pub deps:*)",
      "PowerShell(flutter pub outdated:*)",
      "PowerShell(flutter --version:*)",
      "PowerShell(flutter doctor:*)",
      "PowerShell(flutter clean:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git rev-list:*)",
      "PowerShell(git blame:*)",
      "PowerShell(git merge-base:*)",
      "PowerShell(git cat-file:*)",
      "PowerShell(git hash-object:*)",
      "Bash(dart format:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter --version:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)"
    ],
    "deny": [
      "Read(./env/local.json)",
      "Read(./env/dev.json)",
      "Read(./env/prod-android.json)",
      "Read(./env/prod-ios.json)",
      "Read(./android/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  }
}
